# Copy to .env for local testing. In production, set these in Vercel:
# Project → Settings → Environment Variables. Never commit real values.

# --- SMTP (Gmail / Google Workspace) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Account used to log in to the mail server
SMTP_USER=info@bytecounty.us
# Gmail App Password for SMTP_USER (16 characters, no spaces)
SMTP_PASS=

# --- Addresses ---
# Sender shown on every email. Must be a verified "Send mail as" address in the SMTP_USER account.
MAIL_FROM="Byte County <contact@bytecounty.us>"
# Where consultation requests are delivered
MAIL_TO=contact@bytecounty.us

# --- Security ---
# Comma-separated list of websites allowed to call this API (exact origin, no trailing slash)
ALLOWED_ORIGINS=https://bytecounty.us,https://www.bytecounty.us
# Max submissions per IP per window
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MIN=15

# --- Local testing ---
# true = build emails but don't send them (prints to the console instead)
MAIL_DRY_RUN=false
